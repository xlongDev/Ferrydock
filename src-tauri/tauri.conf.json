{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrydock",
  "version": "0.1.0",
  "identifier": "com.xlongdev.ferrydock",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferrydock",
        "width": 960,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Multi-provider AI gateway for WorkBuddy",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
